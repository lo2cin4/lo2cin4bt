{
  "schema_version": "strategy_run",
  "platform": {
    "strategy_mode_id": "multi_asset_portfolio",
    "strategy_profile_id": "pair_spread_portfolio",
    "workflow_id": "single_backtest",
    "created_at": "2026-07-08",
    "run_type": "example",
    "is_default": true,
    "display_label": "SPY QQQ | Monthly Pair Spread Same Session | yfinance"
  },
  "data": {
    "provider": "yfinance",
    "bar_time": {
      "schema_version": "bar_time_contract.v1",
      "contract_id": "lo2cin4bt.bar_time_contract.v1",
      "session_model": {
        "calendar_id": "XNYS",
        "timezone": "America/New_York",
        "session_scope": "regular",
        "session_label_policy": "exchange_local_date",
        "non_session_bar_policy": "reject"
      },
      "timestamp_model": {
        "time_standard": "UTC",
        "precision": "nanosecond",
        "clock": "historical_available_time",
        "ordering": "available_time_then_event_time_then_external_execution_sequence_then_lifecycle_stage_then_stream_id_then_source_sequence"
      },
      "price_model": {
        "price_basis": "split_dividend_adjusted",
        "corporate_action_policy": "provider_applied"
      },
      "streams": [
        {
          "stream_id": "execution_daily",
          "role": "execution",
          "source": {
            "kind": "external",
            "provider_id": "yfinance"
          },
          "bar_spec": {
            "aggregation": "time",
            "step": 1,
            "unit": "day",
            "price_type": "last",
            "alignment": "session_open"
          },
          "timestamp_semantics": {
            "timestamp_convention": "bar_close",
            "interval_boundary": "left_open_right_closed",
            "bar_open_time_column": "bar_open_timestamp",
            "bar_close_time_column": "bar_close_timestamp",
            "available_time_column": "available_timestamp",
            "session_label_column": "session_label",
            "availability_policy": "bar_close"
          }
        }
      ]
    },
    "stream_binding": {
      "execution_stream_id": "execution_daily",
      "decision_stream_id": "execution_daily"
    },
    "start_date": "2015-01-01",
    "start_policy": "common_available",
    "benchmark": {
      "provider": "yfinance",
      "symbol": "SPY",
      "label": "SPY benchmark"
    }
  },
  "universe": {
    "symbols": ["SPY", "QQQ"],
    "universe_policy": "configured_symbols"
  },
  "computed_fields": [],
  "signals": {
    "entry": {
      "op": "calendar.nth_weekday_of_month",
      "ordinal": 1,
      "weekday": "monday"
    }
  },
  "selection": {},
  "allocation": {
    "method": "fixed_weights",
    "cash_policy": "keep_unallocated_cash"
  },
  "rebalance": {},
  "fill_model": {
    "timing": "timeline",
    "actions": [
      {
        "signal": "entry",
        "offset_bars": 0,
        "price": "open",
        "action": "set_target_weights",
        "weights": {"SPY": 1.0, "QQQ": -1.0}
      },
      {
        "signal": "entry",
        "offset_bars": 0,
        "price": "close",
        "action": "flatten"
      }
    ],
    "cost": {
      "transaction_cost": 0.001,
      "slippage": 0.0005
    }
  },
  "risk": {
    "max_positions": 2,
    "max_gross_exposure": 2.0,
    "long_short": "market_neutral",
    "allow_short": true
  },
  "parameter_domains": {},
  "metricstracker": {
    "enable_metrics_analysis": true,
    "time_unit": 252,
    "risk_free_rate": 0.04
  },
  "outputs": {
    "equity_curve": true,
    "trade_summary": true,
    "entry_exit_markers": true,
    "rebalance_audit": true,
    "holdings": true,
    "asset_contribution": true
  },
  "metadata": {
    "example": true,
    "public_example": true,
    "local_research_only": true,
    "strategy_id": "spy_qqq_monthly_pair_spread_yfinance_example",
    "notes": [
      "This example uses the pair_spread_portfolio contract-reserved profile.",
      "On the first Monday of each month it opens a same-session SPY long versus QQQ short spread, then flattens at the close.",
      "The profile is expressed through shared timeline actions instead of a separate backtest engine family.",
      "This public example is for local research and contract testing only.",
      "It is not a profitability claim, WFA pass, live-trading signal, broker instruction, or investment advice."
    ]
  }
}
