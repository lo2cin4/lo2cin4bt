{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lo2cin4bt/contracts/strategy-run.schema.json",
  "title": "lo2cin4bt Strategy Run Config",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {"required": ["fill_model"]},
    {
      "properties": {
        "platform": {
          "type": "object",
          "properties": {
            "strategy_profile_id": {"const": "selection_timing_portfolio"}
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "platform",
    "data",
    "universe",
    "allocation",
    "risk",
    "parameter_domains",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "strategy_run"},
    "platform": {
      "type": "object",
      "required": ["strategy_mode_id", "workflow_id"],
      "properties": {
        "strategy_mode_id": {
          "enum": [
            "multi_asset_portfolio"
          ]
        },
        "strategy_profile_id": {
          "enum": [
            "selection_timing_portfolio",
            "allocation_portfolio",
            "rotation_portfolio",
            "calendar_event_portfolio",
            "pair_spread_portfolio",
            "multi_leg_event_portfolio"
          ]
        },
        "strategy_preset_id": {
          "enum": [
            "single_asset_signal"
          ]
        },
        "workflow_id": {
          "enum": [
            "single_backtest",
            "parameter_matrix",
            "walk_forward_analysis",
            "rolling_validation",
            "statanalyser"
          ]
        },
        "created_at": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}(?:T.*)?$"},
        "run_type": {
          "enum": [
            "example",
            "public_example",
            "test",
            "production"
          ]
        },
        "is_default": {
          "type": "boolean",
          "description": "True only for an official built-in strategy shown with the Default badge."
        },
        "display_label": {
          "type": "string",
          "pattern": "^[^|]+\\|[^|]+\\|[^|]+$",
          "description": "Three-part authoring identity: assets | strategy concept | provider. Display badges are separate metadata."
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["bar_time", "stream_binding"],
      "allOf": [
        {
          "not": {
            "anyOf": [
              {"required": ["frequency"]},
              {"required": ["interval"]},
              {"required": ["calendar"]},
              {"required": ["timezone"]}
            ]
          }
        }
      ],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "bar_time": {
          "type": "object",
          "required": [
            "schema_version",
            "contract_id",
            "session_model",
            "timestamp_model",
            "price_model",
            "streams"
          ],
          "properties": {
            "schema_version": {"const": "bar_time_contract.v1"},
            "contract_id": {"const": "lo2cin4bt.bar_time_contract.v1"},
            "session_model": {"type": "object"},
            "timestamp_model": {"type": "object"},
            "price_model": {"type": "object"},
            "streams": {"type": "array", "minItems": 1}
          },
          "additionalProperties": false
        },
        "stream_binding": {
          "type": "object",
          "required": ["execution_stream_id", "decision_stream_id"],
          "properties": {
            "execution_stream_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "decision_stream_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "additionalProperties": false
        },
        "start_date": {"type": ["string", "null"]},
        "start_policy": {"type": ["string", "null"]},
        "external_features": {
          "type": "array",
          "description": "External local features to join onto provider market data. Use this for market-level or symbol-level research data such as breadth or macro series.",
          "items": {"type": "object"}
        },
        "benchmark": {
          "type": "object",
          "not": {
            "anyOf": [
              {"required": ["frequency"]},
              {"required": ["interval"]},
              {"required": ["calendar"]},
              {"required": ["timezone"]}
            ]
          }
        }
      }
    },
    "universe": {
      "type": "object",
      "required": ["symbols"],
      "properties": {
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "universe_policy": {"type": ["string", "null"]},
        "survivorship_policy": {"type": ["string", "null"]},
        "source_type": {"type": ["string", "null"]},
        "source_kind": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "source_ref": {"type": ["string", "null"]},
        "historical_constituents_path": {"type": ["string", "null"]},
        "universe_constituents_path": {"type": ["string", "null"]},
        "constituents_path": {"type": ["string", "null"]},
        "source_path": {"type": ["string", "null"]},
        "universe_path": {"type": ["string", "null"]},
        "as_of_date": {"type": ["string", "null"]},
        "as_of": {"type": ["string", "null"]},
        "historical_constituents_as_of": {"type": ["string", "null"]},
        "universe_constituents_as_of": {"type": ["string", "null"]},
        "delisted_policy": {"type": ["string", "null"]},
        "point_in_time_constituents": {"type": "boolean"},
        "point_in_time": {"type": "boolean"},
        "historical_constituents_hash": {"type": ["string", "null"]},
        "universe_constituents_hash": {"type": ["string", "null"]},
        "constituents_hash": {"type": ["string", "null"]}
      }
    },
    "factor_pipeline": {
      "type": "object",
      "maxProperties": 0,
      "deprecated": true,
      "description": "Retired. Omit this field and express supported factor inputs with computed_fields[] so calculations run in the shared Rust engine. The empty object is reserved only for the canonical internal request shape."
    },
    "computed_fields": {
      "type": "array",
      "description": "Public top-level computed indicator/derived-field definitions.",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "op": {"type": "string", "minLength": 1},
          "source": {"type": "string"},
          "right_source": {"type": "string"},
          "value": {"type": "number"},
          "period": {},
          "sampling": {"enum": ["month_end"]},
          "start_lag": {"type": "integer", "minimum": 1},
          "end_lag": {"type": "integer", "minimum": 0},
          "lower": {"type": "number"},
          "upper": {"type": "number"},
          "ascending": {"type": "boolean"},
          "condition": {"enum": ["gt", "ge", "lt", "le", "eq", "ne"]},
          "true_source": {"type": "string"},
          "true_value": {"type": "number"},
          "false_source": {"type": "string"},
          "false_value": {"type": "number"}
        },
        "required": ["name", "op"],
        "additionalProperties": true
      }
    },
    "signals": {"type": "object"},
    "selection": {
      "type": "object",
      "properties": {
        "rank_by": {"type": "string"},
        "rank_order": {"enum": ["asc", "desc"]},
        "top_n": {"type": "integer", "minimum": 1},
        "long_top_n": {"type": "integer", "minimum": 1},
        "short_bottom_n": {"type": "integer", "minimum": 1},
        "tie_breaker": {}
      },
      "additionalProperties": true
    },
    "allocation": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "equal_weight",
            "equal_weight_long_short",
            "fixed_weights",
            "fixed_weight_profiles",
            "position_state",
            "position_target_weight",
            "target_weight_frame",
            "target_weights_frame",
            "explicit_target_weights",
            "calendar_event_overlay"
          ]
        },
        "long_gross_exposure": {"type": "number", "minimum": 0},
        "short_gross_exposure": {"type": "number", "minimum": 0},
        "position_limit": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "rebalance": {"type": "object"},
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_currency": {"type": "string", "pattern": "^[A-Za-z]{3}$"},
            "balance_mode": {"enum": ["normalized_equity", "cash"]},
            "starting_balance": {"type": "number", "exclusiveMinimum": 0},
            "position_mode": {"enum": ["netting", "hedging"]},
            "account_type": {"enum": ["cash", "margin"]},
            "leverage_limit": {"type": "number", "minimum": 1}
          }
        },
        "venue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "venue_id": {"type": "string", "minLength": 1},
            "oms_type": {"enum": ["netting", "hedging"]},
            "book_type": {"enum": ["bar", "l1_mbp", "l2_mbp", "l3_mbo"]},
            "routing": {"const": "simulated"},
            "settlement_days": {"type": "integer", "minimum": 0}
          }
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"const": "historical_event_time"},
            "event_ordering": {"const": "event_time_then_sequence"},
            "tie_breaker": {"const": "source_then_sequence"}
          }
        }
      }
    },
    "fill_model": {
      "type": "object",
      "description": "Public top-level fill timing, cost, slippage, and accounting model.",
      "properties": {
        "timing": {"type": "string"},
        "price": {"type": "string"},
        "cost": {
          "type": "object",
          "properties": {
            "transaction_cost": {"type": "number", "minimum": 0},
            "slippage": {"type": "number", "minimum": 0},
            "short_borrow_rate_annual": {"type": "number", "minimum": 0},
            "borrow_day_count": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "risk": {"type": "object"},
    "parameter_domains": {"type": "object"},
    "combo_limits": {"type": "object"},
    "metricstracker": {
      "type": "object",
      "description": "Performance metric assumptions used by metricstracker and Rust metrics kernels.",
      "properties": {
        "enable_metrics_analysis": {"type": "boolean"},
        "time_unit": {
          "type": ["integer", "number", "string"],
          "description": "Annual session count applied after canonical Rust session-close projection. Defaults to 252 for traditional exchanges and 365 for crypto when omitted."
        },
        "risk_free_rate": {
          "type": ["integer", "number", "string"],
          "description": "Annual risk-free rate. Use 0.04 or 4 for 4%."
        },
        "file_selection_mode": {"type": "string"},
        "parquet_directory": {"type": "string"}
      },
      "additionalProperties": true
    },
    "statanalyser": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "target": {
          "type": "object",
          "properties": {
            "predictor_column": {"type": ["string", "null"]},
            "return_column": {"type": ["string", "null"]},
            "diff_mode": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "tests": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "report": {
          "type": "object",
          "properties": {
            "formats": {"type": "array", "items": {"type": "string"}},
            "output_dir": {"type": "string"},
            "include_plots": {"type": "boolean"},
            "include_raw_tables": {"type": "boolean"},
            "fail_on_error": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "outputs": {"type": "object"},
    "metadata": {
      "type": "object",
      "required": ["strategy_id"],
      "properties": {
        "strategy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "additionalProperties": true
    }
  }
}
