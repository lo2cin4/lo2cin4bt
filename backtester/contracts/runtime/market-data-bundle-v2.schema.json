{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lo2cin4bt/contracts/runtime/market-data-bundle-v2.schema.json",
  "title": "MarketDataBundleV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "bundle_id",
    "content_hash",
    "symbols",
    "calendar",
    "timezone",
    "time_range",
    "row_count",
    "time_column",
    "execution_stream",
    "session_windows",
    "quality",
    "tables",
    "lineage"
  ],
  "properties": {
    "schema_version": {"const": "market_data_bundle.v2"},
    "contract_id": {"const": "lo2cin4bt.market_data_bundle.v2"},
    "bundle_id": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "calendar": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1}
      }
    },
    "row_count": {"type": "integer", "minimum": 1},
    "time_column": {"const": "Time"},
    "execution_stream": {"$ref": "#/$defs/execution_stream"},
    "session_windows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/session_window"}
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_value_policy",
        "duplicate_time_policy",
        "out_of_order_policy",
        "stale_value_policy",
        "warnings"
      ],
      "properties": {
        "missing_value_policy": {"const": "fail"},
        "duplicate_time_policy": {"const": "fail"},
        "out_of_order_policy": {"const": "fail"},
        "stale_value_policy": {"enum": ["preserve", "fail"]},
        "warnings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tables": {
      "type": "object",
      "required": ["open", "high", "low", "close", "volume", "execution_timeline"],
      "minProperties": 6,
      "additionalProperties": {"$ref": "#/$defs/table"},
      "properties": {
        "open": {"$ref": "#/$defs/bar_table"},
        "high": {"$ref": "#/$defs/bar_table"},
        "low": {"$ref": "#/$defs/bar_table"},
        "close": {"$ref": "#/$defs/bar_table"},
        "volume": {"$ref": "#/$defs/bar_table"},
        "execution_timeline": {"$ref": "#/$defs/timeline_table"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_hashes", "point_in_time", "adjustment_policy"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "source_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "point_in_time": {"type": "boolean"},
        "adjustment_policy": {"type": "string"}
      }
    }
  },
  "$defs": {
    "bar_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregation", "step", "unit", "price_type", "alignment"],
      "properties": {
        "aggregation": {"const": "time"},
        "step": {"type": "integer", "minimum": 1},
        "unit": {"enum": ["minute", "hour", "day", "week", "month"]},
        "price_type": {"enum": ["last", "bid", "ask", "mid"]},
        "alignment": {"enum": ["session_open", "calendar_period_start"]}
      }
    },
    "timestamp_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_convention",
        "interval_boundary",
        "external_execution_sequence_column",
        "bar_open_time_column",
        "bar_close_time_column",
        "available_time_column",
        "session_label_column",
        "availability_policy"
      ],
      "properties": {
        "timestamp_convention": {"enum": ["bar_open", "bar_close"]},
        "interval_boundary": {
          "enum": ["left_open_right_closed", "left_closed_right_open"]
        },
        "external_execution_sequence_column": {
          "const": "external_execution_sequence"
        },
        "bar_open_time_column": {"const": "bar_open_timestamp"},
        "bar_close_time_column": {"const": "bar_close_timestamp"},
        "available_time_column": {"const": "available_timestamp"},
        "session_label_column": {"const": "session_label"},
        "availability_policy": {"enum": ["bar_close", "explicit_timestamp"]}
      }
    },
    "execution_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "role",
        "source",
        "session_scope",
        "row_key_kind",
        "bar_spec",
        "timestamp_semantics",
        "timeline_table",
        "ohlcv_tables"
      ],
      "properties": {
        "stream_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "role": {"const": "execution"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "provider_id"],
          "properties": {
            "kind": {"const": "external"},
            "provider_id": {"type": "string", "minLength": 1}
          }
        },
        "session_scope": {"enum": ["regular", "24x7"]},
        "row_key_kind": {"enum": ["session_label", "event_timestamp"]},
        "bar_spec": {"$ref": "#/$defs/bar_spec"},
        "timestamp_semantics": {"$ref": "#/$defs/timestamp_semantics"},
        "timeline_table": {"const": "execution_timeline"},
        "ohlcv_tables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["open", "high", "low", "close", "volume"],
          "properties": {
            "open": {"const": "open"},
            "high": {"const": "high"},
            "low": {"const": "low"},
            "close": {"const": "close"},
            "volume": {"const": "volume"}
          }
        }
      }
    },
    "session_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_label", "open_timestamp", "close_timestamp"],
      "properties": {
        "session_label": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "open_timestamp": {"type": "string", "format": "date-time"},
        "close_timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "transport", "path", "content_hash", "columns", "row_count"],
      "properties": {
        "role": {
          "enum": [
            "bars",
            "bar_timeline",
            "features",
            "benchmarks",
            "instruments",
            "corporate_actions"
          ]
        },
        "transport": {"const": "parquet"},
        "path": {"type": ["string", "null"]},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "row_count": {"type": "integer", "minimum": 1}
      }
    },
    "bar_table": {
      "allOf": [
        {"$ref": "#/$defs/table"},
        {
          "type": "object",
          "properties": {"role": {"const": "bars"}}
        }
      ]
    },
    "timeline_table": {
      "allOf": [
        {"$ref": "#/$defs/table"},
        {
          "type": "object",
          "properties": {
            "role": {"const": "bar_timeline"},
            "columns": {
              "const": [
                "external_execution_sequence",
                "bar_open_timestamp",
                "bar_close_timestamp",
                "available_timestamp",
                "session_label"
              ]
            }
          }
        }
      ]
    }
  }
}
