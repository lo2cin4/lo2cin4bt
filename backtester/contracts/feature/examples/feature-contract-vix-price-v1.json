{
  "schema_version": "1.0",
  "dataset_id": "qqq_price_plus_vix_daily_v1",
  "primary_key": {
    "time_field": "Time",
    "instrument_field": "Trading_instrument"
  },
  "features": [
    {
      "field": "price.close",
      "source": {
        "type": "price",
        "uri": "workspace/datasets/QQQ_1D.csv",
        "column": "Close"
      },
      "bar_spec": {
        "aggregation": "time",
        "step": 1,
        "unit": "day",
        "price_type": "last",
        "alignment": "session_open"
      },
      "timezone": "UTC",
      "dtype": "float",
      "fill_policy": "none",
      "lag_bars": 0,
      "allowed_missing_ratio": 0.0,
      "description": "Primary tradable close price"
    },
    {
      "field": "feature.vix.close",
      "source": {
        "type": "file",
        "uri": "workspace/datasets/VIX_1D.csv",
        "column": "Close"
      },
      "bar_spec": {
        "aggregation": "time",
        "step": 1,
        "unit": "day",
        "price_type": "last",
        "alignment": "session_open"
      },
      "timezone": "UTC",
      "dtype": "float",
      "fill_policy": "ffill",
      "lag_bars": 1,
      "allowed_missing_ratio": 0.02,
      "description": "Regime feature. Lag 1 to avoid look-ahead."
    }
  ],
  "alignment_policy": {
    "join_mode": "left",
    "max_forward_fill_bars": 1,
    "drop_if_missing_ratio_gt": 0.05,
    "enforce_monotonic_time": true
  },
  "time_semantics": {
    "signal_observation_time": "bar_close",
    "trade_earliest_time": "next_bar",
    "default_feature_lag_bars": 1
  }
}
