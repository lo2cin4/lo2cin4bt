*.egg-info/
*.egg
dist/
.tools/
plotter/web/node_modules/
*.tsbuildinfo
build/
outputs/
tmp_*
.tmp_*
tmp_*.png
tmp_*.out
tmp_*.err
tmp_*.py
backtester/rust_sim_kernel_rs/target/
rust/**/target/
rust/**/debug/
rust/**/release/
Cargo.lock.bak

# Test cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
plotter/web/playwright-report/
plotter/web/test-results/

# Local env
.env
.env.*
!.env.example
*.pem
*.key
*.lnk
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
secrets/
private/
README_CLI_STYLE.md
Development_Guideline.md
HowToAddNewTA_AIPROMPT.md
AUTOMODE_DEVELOPMENT_PLAN.md

# Claude / local assistant state
CLAUDE.md
.mcp.json
.claude/
autorunner/DEV_PLAN.md

# Local smoke / archived runtime configs
workspace/_archived_configs/
docs/archive/
docs/drafts/
docs/private/
docs/local/
# Private planning notes stay out of the public GitHub release unless promoted
# to a reviewed public doc.
docs/phase6-factor-strategy-development-plan.md
legacy/

# Source helper scripts belong in this repo even if a parent workspace ignore
# file has a broad scripts/ rule.
!scripts/
!scripts/*.py
!scripts/*.ps1
!scripts/*.sh
!scripts/README.md

# Workspace docs and indicator extension code stay in the repo. Runtime configs,
# datasets, strategy/indicator examples, legacy feature-contract examples, and
# owner-specific examples are local or distributed outside GitHub.
!workspace/
!workspace/README.md
!workspace/indicators/
!workspace/indicators/extensions/
!workspace/indicators/extensions/**/
!workspace/indicators/extensions/**/*.py
!workspace/indicators/extensions/**/manifest.json
workspace/indicators/**/__pycache__/
workspace/indicators/**/*.py[cod]
workspace/calendars/**
workspace/datasets/**
workspace/features/**
workspace/features/*.json
workspace/runs/**
workspace/wfa/**
workspace/strategies/**
workspace/strategies/*.json
workspace/statanalyser/**
workspace/reports/**
workspace/**/*.local.json
workspace/**/.local.*

# Owner-private strategies stay local even if they are moved outside the
# standard workspace/runs directory. Tracked public files must also remain
# free of private strategy text.
private/**
**/*.private.*
**/*.owner-local.*

# Public test/verification fixtures are intentionally small and stable. They
# override broad parent ignores for CSV/data-like files.
!tests/fixtures/
!tests/fixtures/**/
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.json
!tests/fixtures/**/*.xlsx
!verification/fixtures/
!verification/fixtures/**/
!verification/fixtures/**/*.md
!verification/fixtures/**/*.json
!verification/fixtures/**/*.csv
!verification/fixtures/**/*.xlsx
!verification/fixtures/**/*.parquet

# Public README visual assets. These are intentionally allowlisted because the
# parent workspace ignores image and animation extensions by default.
!docs/assets/
!docs/assets/readme/
docs/assets/readme/**
!docs/assets/readme/**/
!docs/assets/readme/.gitkeep
!docs/assets/readme/**/*.png
!docs/assets/readme/**/*.jpg
!docs/assets/readme/**/*.jpeg
!docs/assets/readme/**/*.webp
!docs/assets/readme/**/*.gif
!docs/assets/readme/logos/**/*.svg
!docs/assets/readme/logos/LOGO_SOURCES.md

# Shippori Mincho is bundled locally so the frontend does not depend on a
# network font request at runtime.
!plotter/web/public/fonts/
!plotter/web/public/fonts/shippori-mincho/
!plotter/web/public/fonts/shippori-mincho/*.ttf
plotter/web/public/fonts/shippori-mincho/*.woff2

# App run artifacts stay out of source control.
outputs/app/run_snapshots/**/*.json

# Verification run outputs are regenerated by verification/scripts.
verification/baseline_old/**
verification/candidate_new/**
verification/results/**
!verification/baseline_old/.gitkeep
!verification/candidate_new/.gitkeep
!verification/results/.gitkeep

# Local reference/runtime files
reference/
/assets/*
!/assets/
!/assets/desktop/
/assets/desktop/*
!/assets/desktop/lo2cin4bt-logo.ico
!/assets/readme/
!/assets/readme/**
!assets/readme/logos/**/*.svg

# README source recordings are local editing inputs. Commit generated GIFs or
# reviewed still images instead.
assets/readme/**/*.mp4
assets/readme/**/*.mov
.project_runtime.json
.project_context.json
