*.py[cod]
*.so
*.pyd
*.pyo

# Virtual env
venv/
env/
.venv/

# Logs
logs/
*.log
app_server*.log
plotter_*.log

# Historical records output
records/**/*.parquet
records/**/*.csv
records/**/*.txt
records/**/*.json

# Keep historical records folder anchors and templates only.
!records/**/
!records/**/.gitkeep
!records/autorunner/config_template*.json
!records/autorunner/**/config_template*.json
!records/autorunner/**/config_anchored_template.json
records/plotter/

# Jupyter
.ipynb_checkpoints/

# IDE/Editor
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local media scratch
影片/

