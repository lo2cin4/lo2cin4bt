{
  "schema_version": "strategy_run",
  "platform": {
    "strategy_mode_id": "multi_asset_portfolio",
    "strategy_profile_id": "selection_timing_portfolio",
    "strategy_preset_id": "single_asset_signal",
    "workflow_id": "single_backtest",
    "run_type": "template",
    "display_label": "Template | QQQ | Timeline Signal"
  },
  "data": {
    "provider": "yfinance",
    "bar_time": {
      "schema_version": "bar_time_contract.v1",
      "contract_id": "lo2cin4bt.bar_time_contract.v1",
      "session_model": {
        "calendar_id": "XNYS",
        "timezone": "America/New_York",
        "session_scope": "regular",
        "session_label_policy": "exchange_local_date",
        "non_session_bar_policy": "reject"
      },
      "timestamp_model": {
        "time_standard": "UTC",
        "precision": "nanosecond",
        "clock": "historical_available_time",
        "ordering": "available_time_then_event_time_then_external_execution_sequence_then_lifecycle_stage_then_stream_id_then_source_sequence"
      },
      "price_model": {
        "price_basis": "split_dividend_adjusted",
        "corporate_action_policy": "provider_applied"
      },
      "streams": [
        {
          "stream_id": "execution_daily",
          "role": "execution",
          "source": {
            "kind": "external",
            "provider_id": "yfinance"
          },
          "bar_spec": {
            "aggregation": "time",
            "step": 1,
            "unit": "day",
            "price_type": "last",
            "alignment": "session_open"
          },
          "timestamp_semantics": {
            "timestamp_convention": "bar_close",
            "interval_boundary": "left_open_right_closed",
            "bar_open_time_column": "bar_open_timestamp",
            "bar_close_time_column": "bar_close_timestamp",
            "available_time_column": "available_timestamp",
            "session_label_column": "session_label",
            "availability_policy": "bar_close"
          }
        }
      ]
    },
    "stream_binding": {
      "execution_stream_id": "execution_daily",
      "decision_stream_id": "execution_daily"
    },
    "start_date": "2020-01-01",
    "start_policy": "common_available",
    "benchmark": {
      "provider": "yfinance",
      "symbol": "QQQ",
      "label": "QQQ buy and hold"
    }
  },
  "universe": {
    "symbols": ["QQQ"],
    "universe_policy": "single_asset"
  },
  "computed_fields": [],
  "signals": {
    "entry": {"field": "close", "op": "gt", "value": 0},
    "exit": {"field": "close", "op": "lt", "value": 0}
  },
  "selection": {},
  "allocation": {},
  "rebalance": {},
  "fill_model": {
    "timing": "timeline",
    "position_policy": {
      "on_entry_signal_while_holding": "ignore_new_signal"
    },
    "actions": [
      {"signal": "entry", "offset_bars": 1, "price": "open", "action": "enter"},
      {"signal": "exit", "offset_bars": 1, "price": "open", "action": "exit"}
    ],
    "cost": {
      "transaction_cost": 0.001,
      "slippage": 0.0005
    }
  },
  "risk": {
    "max_positions": 1,
    "max_gross_exposure": 1.0,
    "long_short": "long_only",
    "allow_short": false
  },
  "parameter_domains": {},
  "outputs": {
    "equity_curve": true,
    "holdings": true,
    "risk_events": true
  },
  "metricstracker": {
    "enable_metrics_analysis": true,
    "time_unit": 252,
    "risk_free_rate": 0.04
  },
  "metadata": {
    "strategy_id": "template_timeline_strategy",
    "display_name": "Template Timeline Strategy"
  }
}
